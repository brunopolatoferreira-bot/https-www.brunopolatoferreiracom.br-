<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Bruno Polato Ferreira, Analista de Produto Sênior com 15+ anos em crédito e serviços financeiros. +15% em vendas e −20% em incidentes no Banco Toyota. Campeão FIAP Startup One 2024.">
<meta property="og:title" content="Bruno Polato Ferreira · Analista de Produto Sênior">
<meta property="og:description" content="15+ anos em produtos de crédito. +15% em vendas, −20% em incidentes. Disponível para vagas no Brasil e internacionais remotas.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://brunopolatoferreira.com.br/">
<link rel="canonical" href="https://brunopolatoferreira.com.br/">
<style>body{margin:0;font-family:system-ui,sans-serif}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Bruno Polato Ferreira</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Sans+3:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: página-currículo de leitura vertical; hero com tese + placar de resultados, seletor de vaga que destaca a trajetória, linha do tempo expansível. Bilíngue PT/EN. */
:root{
  --bg:#f5f6f9; --surface:#ffffff; --ink:#14213a; --muted:#56607a; --line:#dde1ea;
  --accent:#9a6a10; --accent-soft:#f6ecd6; --navy:#14213a; --on-navy:#f3f0e8;
  --dim:.38;
  --f-display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --f-body:"Source Sans 3", "Segoe UI", system-ui, sans-serif;
  --f-mono:"JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0d1526; --surface:#142038; --ink:#e9ecf3; --muted:#9aa5bd; --line:#26324d;
  --accent:#e2b35c; --accent-soft:#2a2a26; --navy:#0a1120; --on-navy:#f3f0e8; color-scheme:dark;}}
:root[data-theme="dark"]{
  --bg:#0d1526; --surface:#142038; --ink:#e9ecf3; --muted:#9aa5bd; --line:#26324d;
  --accent:#e2b35c; --accent-soft:#2a2a26; --navy:#0a1120; --on-navy:#f3f0e8; color-scheme:dark;}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.6;margin:0}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--navy)}
.wrap{max-width:1080px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0;line-height:1.1}
h2{font-size:clamp(1.7rem,3.4vw,2.4rem);font-weight:700;letter-spacing:-.01em}
h3{font-size:1.2rem;font-weight:700}
p{margin:0}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
.eyebrow{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600}
section{padding-block:72px}
.sec-head{display:grid;gap:10px;margin-bottom:32px;max-width:680px}
.sec-head p{color:var(--muted)}

/* nav */
header.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--navy);color:var(--on-navy)}
header.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-block:12px}
.brand{font-family:var(--f-display);font-weight:800;font-size:1.05rem;text-decoration:none;white-space:nowrap}
.brand span{color:#e2b35c}
.nav-right{display:flex;align-items:center;gap:18px}
nav.links{display:flex;gap:18px;flex-wrap:wrap;font-size:.93rem}
nav.links a{text-decoration:none;opacity:.82}
nav.links a:hover{opacity:1;color:#e2b35c}
.lang{display:inline-flex;border:1px solid #3d4b6a;border-radius:999px;overflow:hidden;flex:none}
.lang button{font-family:var(--f-mono);font-size:.74rem;font-weight:600;letter-spacing:.06em;background:transparent;color:#c9cfdc;border:0;padding:6px 10px;cursor:pointer}
.lang button[aria-pressed="true"]{background:#e2b35c;color:#14213a}
@media (max-width:820px){nav.links .opt{display:none}}
@media (max-width:560px){nav.links{display:none}.brand{font-size:.98rem}}

/* hero */
.hero{background:var(--navy);color:var(--on-navy);padding-block:64px 56px}
.hero-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;align-items:end}
.hero .eyebrow{color:#e2b35c}
.hero h1{font-size:clamp(2.2rem,5.4vw,3.9rem);font-weight:800;letter-spacing:-.02em;margin-top:24px}
.hero-id{display:flex;align-items:center;gap:18px}
.portrait{width:104px;height:104px;border-radius:50%;object-fit:cover;border:3px solid #e2b35c;flex:none;background:#22304d}
.hero-name{font-family:var(--f-display);font-weight:700;font-size:1.2rem;margin-bottom:4px}
@media (max-width:420px){.portrait{width:80px;height:80px}}
.hero h1 em{font-style:normal;color:#e2b35c}
.hero .lede{margin-top:20px;max-width:560px;font-size:1.12rem;color:#c9cfdc}
.hero .meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.chip{font-family:var(--f-mono);font-size:.76rem;padding:6px 10px;border:1px solid #33415f;border-radius:999px;color:#d7dbe5}
.chip.live{border-color:#e2b35c;color:#e2b35c}
.chip.live::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:#7fd19b;margin-right:7px;vertical-align:1px}
.chip.intl{border-color:#5b7bb5;color:#b9cdf2}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--f-body);font-weight:600;font-size:1rem;padding:12px 20px;border-radius:8px;border:1px solid transparent;cursor:pointer;text-decoration:none}
.btn.gold{background:#e2b35c;color:#14213a}
.btn.gold:hover{background:#ecc275}
.btn.ghost{background:transparent;color:var(--on-navy);border-color:#3d4b6a}
.btn.ghost:hover{border-color:#e2b35c}

/* scoreboard */
.score{display:grid;grid-template-columns:1fr 1fr;border:1px solid #2c3a58;border-radius:14px;overflow:hidden}
.score div{padding:22px 20px;border-right:1px solid #2c3a58;border-bottom:1px solid #2c3a58;min-width:0}
.score div:nth-child(2n){border-right:0}
.score div:nth-last-child(-n+2){border-bottom:0}
.score b{display:block;font-family:var(--f-display);font-size:clamp(2rem,4vw,2.8rem);font-weight:800;color:#e2b35c;line-height:1;font-variant-numeric:tabular-nums}
.score small{display:block;margin-top:8px;font-size:.88rem;color:#c3c9d6;line-height:1.35}
.score-note{font-family:var(--f-mono);font-size:.72rem;color:#8d97ad;margin-top:10px}
@media (max-width:860px){.hero-grid{grid-template-columns:1fr;gap:36px}}

/* award */
.award{background:var(--accent-soft);border-bottom:1px solid var(--line)}
.award .wrap{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px 28px;padding-block:28px}
.medal{width:64px;height:64px;border-radius:50%;background:#e2b35c;color:#14213a;display:grid;place-items:center;font-family:var(--f-display);font-weight:800;font-size:1.5rem;box-shadow:0 0 0 6px color-mix(in srgb,#e2b35c 30%,transparent)}
.award .eyebrow{display:block;margin-bottom:6px}
.award h3{font-size:clamp(1.25rem,2.6vw,1.6rem)}
.award p{color:var(--muted);margin-top:6px;max-width:640px}
.award-steps{display:flex;gap:10px;flex-wrap:wrap}
.award-steps span{font-family:var(--f-mono);font-size:.76rem;padding:6px 10px;border-radius:6px;background:var(--surface);border:1px solid var(--line);white-space:nowrap}
.award-steps b{color:var(--accent)}
@media (max-width:820px){.award .wrap{grid-template-columns:auto 1fr}.award-steps{grid-column:1/-1}}
@media (max-width:440px){.award .wrap{grid-template-columns:1fr}.medal{width:52px;height:52px;font-size:1.2rem}}

/* international band */
.intl-band{background:var(--surface);border-bottom:1px solid var(--line)}
.intl-band .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;padding-block:18px}
.intl-band p{max-width:720px}
.intl-band b{font-family:var(--f-display)}
.intl-band a{color:var(--accent);font-weight:600;white-space:nowrap}

/* fit selector */
.fit{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:28px;display:grid;gap:22px}
.roles{display:flex;flex-wrap:wrap;gap:10px}
.role{font-family:var(--f-body);font-size:.98rem;font-weight:600;padding:10px 16px;border-radius:999px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.role:hover{border-color:var(--accent)}
.role[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.fit-out{display:grid;grid-template-columns:1.2fr 1fr;gap:28px}
.fit-out > div{min-width:0}
.fit-out h3{margin-bottom:10px}
.fit-out p{color:var(--muted)}
.fit-out ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.fit-out li{display:flex;gap:10px;align-items:flex-start}
.fit-out li::before{content:"";flex:none;width:8px;height:8px;margin-top:9px;background:var(--accent);transform:rotate(45deg)}
.fit-cta{font-size:.92rem;color:var(--muted)}
.fit-cta a{color:var(--accent);font-weight:600}
@media (max-width:760px){.fit-out{grid-template-columns:1fr}}

/* timeline */
.tl{display:grid;gap:0;border-left:2px solid var(--line);margin-left:6px}
.job{position:relative;padding:0 0 28px 28px;transition:opacity .25s}
.job::before{content:"";position:absolute;left:-8px;top:8px;width:14px;height:14px;border-radius:50%;background:var(--bg);border:2px solid var(--muted)}
.job.hl::before{background:var(--accent);border-color:var(--accent)}
.job.dim{opacity:var(--dim)}
.job-card{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.job.hl .job-card{border-color:var(--accent)}
.job-top{display:grid;grid-template-columns:1fr auto;gap:6px 16px;width:100%;text-align:left;background:none;border:0;padding:18px 20px;cursor:pointer;color:inherit;font:inherit}
.job-top > *{min-width:0}
.job-when{font-family:var(--f-mono);font-size:.78rem;color:var(--muted);grid-column:1/-1}
.job-org{font-family:var(--f-display);font-weight:700;font-size:1.25rem}
.job-role{color:var(--muted);font-size:.98rem;grid-column:1/2}
.job-win{grid-column:1/2;margin-top:6px;font-weight:600}
.job-win mark{background:var(--accent-soft);color:var(--ink);padding:1px 6px;border-radius:4px;font-family:var(--f-mono);font-size:.9em}
.toggle{grid-column:2/3;grid-row:2/4;align-self:center;font-family:var(--f-mono);font-size:.78rem;color:var(--accent);white-space:nowrap}
.job-body{padding:0 20px 20px;border-top:1px dashed var(--line)}
.job-body ul{margin:16px 0 0;padding-left:20px;display:grid;gap:8px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.tag{font-family:var(--f-mono);font-size:.7rem;letter-spacing:.04em;padding:4px 8px;border-radius:5px;background:var(--bg);border:1px solid var(--line);color:var(--muted)}
.early-label{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding:6px 0 18px 28px}

/* skills */
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.skill{padding:22px;border-top:3px solid var(--ink);background:var(--surface);border-radius:0 0 10px 10px}
.skill h3{margin-bottom:8px}
.skill p{color:var(--muted);font-size:.98rem}
@media (max-width:860px){.skills{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.skills{grid-template-columns:1fr}}

/* edu */
.edu{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line)}
.edu-item{display:grid;grid-template-columns:110px 1fr;gap:16px;padding:20px 0;border-bottom:1px solid var(--line)}
.edu-item:nth-child(odd){padding-right:24px}
.edu-item:nth-child(even){padding-left:24px;border-left:1px solid var(--line)}
.edu-item > div{min-width:0}
.edu-when{font-family:var(--f-mono);font-size:.8rem;color:var(--accent);font-weight:600}
.edu-item b{display:block;font-family:var(--f-display);font-size:1.08rem}
.edu-item span{color:var(--muted);font-size:.95rem}
@media (max-width:760px){.edu{grid-template-columns:1fr}.edu-item:nth-child(n){padding-left:0;padding-right:0;border-left:0}}
@media (max-width:420px){.edu-item{grid-template-columns:1fr;gap:4px}}

/* contact */
.contact{background:var(--navy);color:var(--on-navy)}
.contact .eyebrow{color:#e2b35c}
.contact-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:start}
.contact p.lead{color:#c9cfdc;margin-top:14px;max-width:520px}
.contact-list{display:grid;gap:12px}
.c-row{display:grid;grid-template-columns:1fr auto;align-items:center;gap:12px;padding:14px 16px;border:1px solid #2c3a58;border-radius:10px}
.c-row > div{min-width:0}
.c-row small{display:block;font-family:var(--f-mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:#8d97ad}
.c-row span,.c-row a.val{overflow-wrap:anywhere;user-select:all}
.c-actions{display:flex;gap:8px}
.copy,.open{font-family:var(--f-mono);font-size:.76rem;background:transparent;color:#e2b35c;border:1px solid #4a4632;border-radius:6px;padding:6px 10px;cursor:pointer;text-decoration:none;white-space:nowrap}
.copy:hover,.open:hover{border-color:#e2b35c}
footer{padding-block:24px;font-size:.85rem;color:#8d97ad;border-top:1px solid #1f2b45}
@media (max-width:760px){.contact-grid{grid-template-columns:1fr}}
</style>
</head>
<body>


<header class="nav">
  <div class="wrap">
    <a class="brand" href="#topo">Bruno <span>Polato</span> Ferreira</a>
    <div class="nav-right">
      <nav class="links" aria-label="Seções">
        <a href="#resultados" class="opt" data-i18n="nav1">Resultados</a>
        <a href="#vaga" data-i18n="nav2">Sua vaga</a>
        <a href="#trajetoria" data-i18n="nav3">Trajetória</a>
        <a href="#formacao" class="opt" data-i18n="nav4">Formação</a>
        <a href="#contato" data-i18n="nav5">Contato</a>
      </nav>
      <div class="lang" role="group" aria-label="Idioma / Language">
        <button id="lang-pt" data-lang="pt" aria-pressed="true">PT</button>
        <button id="lang-en" data-lang="en" aria-pressed="false">EN</button>
      </div>
    </div>
  </div>
</header>

<div class="hero" id="topo">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-id"><img class="portrait" src="data:image/jpeg;base64," width="104" height="104" alt="Foto de Bruno Polato Ferreira"><div><p class="hero-name">Bruno Polato Ferreira</p><p class="eyebrow" data-i18n="eyebrow">Produto digital · IA · Resultado</p></div></div>
      <h1 data-i18n="h1">Conecto negócio e tecnologia para produtos digitais performarem melhor, <em>com IA no dia a dia</em>.</h1>
      <p class="lede" data-i18n="lede">Analista de Produto Sênior com mais de 15 anos de experiência. Uso IA para descobrir, prototipar e entregar mais rápido, para que o produto venda mais e quebre menos.</p>
      <div class="meta">
        <span class="chip live" data-i18n="c1">Disponível para início imediato</span>
        <span class="chip intl" data-i18n="c2">Aberto a vagas internacionais remotas</span>
        <span class="chip" data-i18n="c3">Mogi das Cruzes · SP</span>
        <span class="chip" data-i18n="c4">Remoto ou híbrido</span>
        <span class="chip" data-i18n="c5">Inglês fluente</span>
      </div>
      <div class="cta-row">
        <a class="btn gold" href="#contato" data-i18n="cta1">Falar com o Bruno</a>
        <a class="btn ghost" href="#vaga" data-i18n="cta2">Ver aderência à sua vaga</a>
      </div>
    </div>
    <div id="resultados">
      <div class="score">
        <div><b data-count="15" data-prefix="+" data-suffix="%">+15%</b><small data-i18n="s1">em vendas no Banco Toyota com melhorias no front de digitação de propostas</small></div>
        <div><b data-count="20" data-prefix="−" data-suffix="%">−20%</b><small data-i18n="s2">em incidentes no mesmo sistema, em 12 meses</small></div>
        <div><b data-count="15" data-suffix="+">15+</b><small data-i18n="s3">anos em produtos e serviços financeiros</small></div>
        <div><b data-count="7">7</b><small data-i18n="s4">instituições, incluindo uma no exterior (Irlanda)</small></div>
      </div>
      <p class="score-note" data-i18n="snote">★ Campeão FIAP Startup One · 1ª temporada 2024</p>
    </div>
  </div>
</div>

<div class="award" id="premio">
  <div class="wrap">
    <div class="medal" aria-hidden="true">1º</div>
    <div data-i18n="aw"><span class="eyebrow">Premiação</span><h3>Campeão do FIAP Startup One · 1ª temporada de 2024</h3><p>Como cofundador da ParkingPass, venci a competição de startups da FIAP. O prêmio levou o time a um programa de empreendedorismo no Babson College, referência mundial no tema, em 2025.</p></div>
    <div class="award-steps" data-i18n="aw-steps"><span><b>2024</b> · 1º lugar FIAP</span><span><b>2025</b> · Babson College (EUA)</span></div>
  </div>
</div>

<div class="intl-band">
  <div class="wrap">
    <p data-i18n="intl"><b>Disponível para vagas internacionais em formato remoto.</b> Inglês fluente e mais de dois anos em banco europeu, em ambiente multicultural.</p>
    <a href="#contato" data-i18n="intlcta">Entrar em contato →</a>
  </div>
</div>

<section id="vaga">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow" data-i18n="v-eye">Para recrutadores</p>
      <h2 data-i18n="v-h">Qual vaga você está preenchendo?</h2>
      <p data-i18n="v-p">Escolha o perfil e a trajetória abaixo destaca as experiências que mais conversam com ele.</p>
    </div>
    <div class="fit">
      <div class="roles" role="group" aria-label="Perfil da vaga">
        <button class="role" id="r-produto" data-role="produto" aria-pressed="true" data-i18n="r1">Analista de Produtos</button>
        <button class="role" id="r-projetos" data-role="projetos" aria-pressed="false" data-i18n="r2">Analista de Projetos</button>
        <button class="role" id="r-comercial" data-role="comercial" aria-pressed="false" data-i18n="r3">Planejamento Comercial</button>
        <button class="role" id="r-po" data-role="po" aria-pressed="false" data-i18n="r4">Product Owner / PM</button>
        <button class="role" id="r-todas" data-role="todas" aria-pressed="false" data-i18n="r5">Ver tudo</button>
      </div>
      <div class="fit-out" aria-live="polite">
        <div>
          <h3 id="fit-title"></h3>
          <p id="fit-text"></p>
        </div>
        <div><ul id="fit-list"></ul></div>
      </div>
      <p class="fit-cta" data-i18n="fitcta">Vaga com outro nome, mas pedindo experiência parecida? <a href="#contato">Vamos conversar.</a></p>
    </div>
  </div>
</section>

<section id="trajetoria" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow" data-i18n="t-eye">Trajetória</p>
      <h2 data-i18n="t-h">Experiência, do mais recente ao mais antigo</h2>
      <p data-i18n="t-p">Clique em cada empresa para ver o detalhe das entregas.</p>
    </div>

    <div class="tl" id="tl">
      <article class="job" data-tags="produto po projetos">
        <div class="job-card">
          <button class="job-top" id="j-bradesco" aria-expanded="false">
            <span class="job-when" data-i18n="b-when">jun 2026 – ago 2026</span>
            <span class="job-org">Banco Bradesco</span>
            <span class="job-role" data-i18n="b-role">Product Owner Sênior · Squad de crédito</span>
            <span class="job-win" data-i18n="b-win">CCB digital com assinatura biométrica e validação de autenticidade</span>
            <span class="toggle">+ detalhes</span>
          </button>
