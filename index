window.addEventListener('hashchange',()=>{const h=location.hash.slice(1); if(h==='en'||h==='pt') setLang(h);});

document.querySelectorAll('.job-top').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const body=btn.nextElementSibling, open=btn.getAttribute('aria-expanded')==='true';
    btn.setAttribute('aria-expanded',!open); body.hidden=open;
    btn.querySelector('.toggle').textContent=open?UI[lang].more:UI[lang].less;
  });
});

document.querySelectorAll('.copy').forEach(b=>b.addEventListener('click',()=>{
  const el=document.getElementById(b.dataset.target), txt=el.textContent.trim();
  const done=()=>{b.textContent=UI[lang].copied;setTimeout(()=>b.textContent=UI[lang].copy,1600)};
  const fallback=()=>{const s=window.getSelection(),r=document.createRange();r.selectNodeContents(el);s.removeAllRanges();s.addRange(r);b.textContent=UI[lang].sel};
  try{navigator.clipboard.writeText(txt).then(done,fallback)}catch(e){fallback()}
}));

// idioma inicial: #en no link > escolha salva > português
let startLang='pt', startRole='produto';
try{startLang=localStorage.getItem('bpf-lang')||'pt'; startRole=localStorage.getItem('bpf-role')||'produto'}catch(e){}
const h0=location.hash.slice(1); if(h0==='en'||h0==='pt') startLang=h0;
setRole(FIT.pt[startRole]?startRole:'produto');
setLang(startLang==='en'?'en':'pt');

if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
  document.querySelectorAll('[data-count]').forEach(el=>{
    const n=+el.dataset.count,pre=el.dataset.prefix||'',suf=el.dataset.suffix||'';let t0=null;
    const step=ts=>{t0??=ts;const k=Math.min(1,(ts-t0)/900);el.textContent=pre+Math.round(n*(1-Math.pow(1-k,3)))+suf;if(k<1)requestAnimationFrame(step)};
    requestAnimationFrame(step);
  });
}
</script>

